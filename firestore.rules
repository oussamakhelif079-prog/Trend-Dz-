rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // TREND DZ - OWNER ACCESS CONTROL HELPER
    // Replace "ضع_هنا_UID_حسابي" with your real Firebase Auth UID.
    // Or grant custom user claim { role: "owner" } via Firebase Admin SDK.
    // =========================================================================
    function isOwner() {
      return request.auth != null && (
        request.auth.uid == "ضع_هنا_UID_حسابي" ||
        request.auth.token.role == "owner"
      );
    }
    
    // User profile access rules
    // STRICT SECURITY: A regular user CANNOT promote themselves to 'owner' or modify the 'role' field!
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && 
                       request.auth.uid == userId &&
                       (request.resource.data.role == 'user' || (request.resource.data.role == 'owner' && isOwner()));
      allow update: if request.auth != null && (
        // Regular user modifying their own profile: FORBID modifying the 'role' attribute
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
        // Owner can manage accounts
        isOwner()
      );
      allow delete: if request.auth != null && (request.auth.uid == userId || isOwner());
    }
    
    // Posts access rules
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null && 
                       request.resource.data.authorId == request.auth.uid &&
                       (request.resource.data.authorRole == 'user' || (request.resource.data.authorRole == 'owner' && isOwner()));
      // Allow author or Owner to update post content, or any authenticated user to update engagement counters
      allow update: if request.auth != null && (
        resource.data.authorId == request.auth.uid ||
        isOwner() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedBy', 'sharesCount', 'viewsCount', 'commentsCount'])
      );
      allow delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isOwner());
      
      // Subcollection comments
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null && 
                         request.resource.data.authorId == request.auth.uid &&
                         (request.resource.data.authorRole == 'user' || (request.resource.data.authorRole == 'owner' && isOwner()));
        allow update: if request.auth != null && (
          resource.data.authorId == request.auth.uid ||
          isOwner() ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedBy'])
        );
        allow delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isOwner());
      }
    }
    
    // Top-level comments collection
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null && 
                       request.resource.data.authorId == request.auth.uid &&
                       (request.resource.data.authorRole == 'user' || (request.resource.data.authorRole == 'owner' && isOwner()));
      allow update: if request.auth != null && (
        resource.data.authorId == request.auth.uid ||
        isOwner() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedBy'])
      );
      allow delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isOwner());
    }

    // Reports moderation collection (Owner can read and review reports)
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isOwner();
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.recipientId == request.auth.uid;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.recipientId == request.auth.uid || isOwner());
    }
  }
}

